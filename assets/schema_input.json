
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ONT methylation sample sheet",
  "description": "Input BAM and reference FASTA files",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "properties": {
      "sample": {
        "type": "string",
        "minLength": 1,
        "meta": "id",
        "pattern": "^[A-Za-z0-9_-]+$",
        "description": "Unique sample identifier"
      },
      "bam": {
        "type": "string",
        "minLength": 1,
        "exists": true,
        "pattern": "(?i)\\.bam$",
        "description": "Modification-tagged BAM file"
      },
      "assembly": {
        "type": "string",
        "minLength": 1,
        "exists": true,
        "pattern": "(?i)\\.(fa|fasta|fna)$",
        "description": "Reference genome FASTA"
      }
    },
    "required": [
      "sample",
      "bam",
      "assembly"
    ],
    "additionalProperties": false
  }
}
