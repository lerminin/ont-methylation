nextflow_process {

    name "Test Process ZIPFASTQ"
    script "modules/map_index_bam.nf"
    process "ZIPFASTQ"

    test("Should gzip FASTQ") {
        
        when {
            process {
                """
                input[0] = [
                    [id: 'barcode01'],
                    file(params.modules_testdata_base_path + 'isolate_test/barcode01.fastq'),
                    file(params.modules_testdata_base_path + 'isolate_test/barcode01_reference.fasta')
                ]
                """
            }
        }

        then {
            assert process.success

            // Check output channel
            assert process.out[0].size() == 1

            // Extract output tuple
            def result = process.out[0].get(0)

            // Check metadata
            assert result[0].id == 'barcode01'

            // Check FASTQ file
            def fastq = path(result[1])
            assert fastq.exists()
            assert fastq.size() > 0
            assert fastq.getFileName().toString().endsWith('.fastq.gz')
            assert fastq.bytes[0] == (byte) 0x1f
            assert fastq.bytes[1] == (byte) 0x8b

            // Check assembly is preserved
            assert path(result[2]).exists()

            // Snapshot outputs
            assert snapshot(process.out).match()
        }

    }

    test("Stub run") {

        options "-stub-run"
        
        when {
            process {
                """
                input[0] = [
                    [id: 'barcode01'],
                    file(params.modules_testdata_base_path + 'isolate_test/barcode01.fastq'),
                    file(params.modules_testdata_base_path + 'isolate_test/barcode01_reference.fasta')
                ]
                """
            }
        }

        then {
            assert process.success
            assert process.out.size() == 1
            assert snapshot(process.out).match()
        }

    }

}
