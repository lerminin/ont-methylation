nextflow_process {

    name "Test Process MINIMAP2"
    script "modules/map_index_bam.nf"
    process "MINIMAP2"

    test("Should produce mapped bam") {
        
        when {
            process {
                """
                input[0] = [
                    [id: 'barcode01'],
                    file(params.modules_testdata_base_path + 'isolate_test/barcode01.fastq'),
                    file(params.modules_testdata_base_path + 'isolate_test/barcode01_reference.fasta')
                ]
                """
            }
        }

        then {
            assert process.success

            // Check output channel
            assert process.out[0].size() == 1

            // Extract output tuple
            def result = process.out[0].get(0)

            // Check metadata
            assert result[0].id == 'barcode01'

            // Check mapped bam file
            def mapped_bam = path(result[1])
            assert mapped_bam.exists()
            assert mapped_bam.size() > 0
            assert mapped_bam.getFileName().toString().endsWith('.bam')

            // Check index
            def index = path(result[2])
            assert index.exists()
            assert index.size() > 0
            assert index.getFileName().toString().endsWith('.bam.bai')

            // Check assembly is preserved
            assert path(result[3]).exists()

            // Snapshot outputs
            assert snapshot(process.out).match()
        }

    }

    test("Stub run") {

        options "-stub-run"
        
        when {
            process {
                """
                input[0] = [
                    [id: 'barcode01'],
                    file(params.modules_testdata_base_path + 'isolate_test/barcode01.fastq'),
                    file(params.modules_testdata_base_path + 'isolate_test/barcode01_reference.fasta')
                ]
                """
            }
        }

        then {
            assert process.success
            assert process.out.size() == 1
            assert snapshot(process.out).match()
        }

    }

}
