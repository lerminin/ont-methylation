nextflow_process {

    name "Test Process BAM2FASTQ"
    script "modules/map_index_bam.nf"
    process "BAM2FASTQ"

    test("Should run without failures in -stub-run") {

        options "-stub-run"
        
        when {
            params {
                // define parameters here. Example:
                // outdir = "tests/results"
            }
            process {
                """
                input[0] = [
                    [id: 'barcode01'],
                    file(modules_testdata_base_path + 'isolate_test/barcode01_subsample.bam'),
                    file(modules_testdata_base_path + 'isolate_test/barcode01_reference.fasta')
                ]
                """
            }
        }

        then {
            assert process.success
            assert process.out.files.size() == 1
            ssert process.out.versions.size() == 1
            assert snapshot(process.out).match()
        }

    }

}
