nextflow_process {

    name "Test Process BAM2FASTQ"
    script "modules/map_index_bam.nf"
    process "BAM2FASTQ"

    test("Should convert BAM to FASTQ") {
        
        when {
            process {
                """
                input[0] = [
                    [id: 'barcode01'],
                    file(params.modules_testdata_base_path + 'isolate_test/barcode01_subsample.bam'),
                    file(params.modules_testdata_base_path + 'isolate_test/barcode01_reference.fasta')
                ]
                """
            }
        }

        then {
            assert process.success

            // Check output channel
            assert process.out.files.size() == 1
            assert process.out.versions.size() == 1

            // Extract output tuple
            def result = process.out.files.get(0)

            // Check metadata
            assert result[0].id == 'barcode01'

            // Check FASTQ file
            def fastq = path(result[1])
            assert fastq.exists()
            assert fastq.size() > 0

            // Check assembly is preserved
            assert path(result[2]).exists()

            // Check versions output
            assert path(process.out.versions.get(0)).exists()

            // Snapshot outputs
            assert snapshot(process.out).match()
        }

    }
    
    test("Stub run") {

        options "-stub-run"
        
        when {
            process {
                """
                input[0] = [
                    [id: 'barcode01'],
                    file(params.modules_testdata_base_path + 'isolate_test/barcode01_subsample.bam'),
                    file(params.modules_testdata_base_path + 'isolate_test/barcode01_reference.fasta')
                ]
                """
            }
        }

        then {
            assert process.success
            assert process.out.files.size() == 1
            assert process.out.versions.size() == 1
            assert snapshot(process.out).match()
        }

    }

}
